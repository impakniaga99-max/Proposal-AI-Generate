                    body: JSON.stringify(payload)
                });
                
                if (!response.ok) {
                    throw new Error(`Ralat API: ${response.statusText}`);
                }

                const result = await response.json();
                const textContent = result.candidates[0].content.parts[0].text;
                
                // Parse JSON Safely
                const jsonStart = textContent.indexOf('{');
                const jsonEnd = textContent.lastIndexOf('}');
                if (jsonStart === -1 || jsonEnd === -1) {
                    throw new Error("Kandungan JSON yang sah tidak ditemui dalam respons AI.");
                }
                const jsonString = textContent.substring(jsonStart, jsonEnd + 1);
                const cleanedJsonString = jsonString.replace(/,\s*([}\]])/g, "$1"); // remove trailing commas

                let aiContent;
                try {
                    aiContent = JSON.parse(cleanedJsonString);
                } catch (error) {
                    // Last resort attempt if cleaning failed
                    try {
                        aiContent = JSON.parse(jsonString); 
                    } catch(e) {
                        throw new Error("Respons AI tidak mengandungi format JSON yang sah.");
                    }
                }
                
                // Generate Content
                const tentatifHTML = generateTentatif(tarikhMula, bilanganHari, sesiMalamAktif, bahasa);
                const bajetHTML = generateBajet(bilanganHari, bilanganPeserta, bajetPerPeserta, lokasiProgram, bahasa);

                displayKertasKerja(aiContent, { namaProgram, namaSyarikat, tentatifHTML, bajetHTML }, bahasa);

                // Show UI
                welcomeState.classList.add('hidden');
                outputSection.classList.remove('hidden');
                
                // Scroll specifically to output on mobile
                if(window.innerWidth < 1024) {
                    outputSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }

            } catch (error) {
                console.error("Ralat semasa menjana kandungan:", error);
                alert("Maaf, terdapat masalah semasa menjana kertas kerja. Sila cuba lagi.\n\n" + error.message);
            } finally {
                toggleLoading(false);
            }
        });
        
        function toggleLoading(isLoading) {
            const btn = form.querySelector('button[type="submit"]');
            if (isLoading) {
                loadingSpinner.classList.remove('hidden');
                submitIcon.classList.add('hidden');
                buttonText.textContent = 'Sedang Menjana...';
                btn.disabled = true;
                btn.classList.add('opacity-75', 'cursor-not-allowed');
            } else {
                loadingSpinner.classList.add('hidden');
                submitIcon.classList.remove('hidden');
                buttonText.textContent = 'Jana Kertas Kerja';
                btn.disabled = false;
                btn.classList.remove('opacity-75', 'cursor-not-allowed');
            }
        }

        // Logic Generators
        function generateTentatif(startDate, numDays, sesiMalamAktif, bahasa) {
            const T = labels[bahasa];
            let html = '';
            const locale = bahasa === 'english' ? 'en-GB' : 'ms-MY';
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };

            for (let i = 0; i < numDays; i++) {
                const currentDate = new Date(startDate.getTime());
                currentDate.setDate(startDate.getDate() + i);
                const formattedDate = currentDate.toLocaleDateString(locale, options);
                const hariKe = i + 1;
                
                html += `<h3>${T.day} ${hariKe} (${formattedDate.toUpperCase()})</h3>`;
                html += `
                    <table>
                        <thead>
                            <tr>
                                <th style="width: 25%;">${T.time}</th>
                                <th>${T.activity}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>08:30 pagi - 09:00 pagi</td><td>${T.registration}</td></tr>
                            <tr><td>09:00 pagi - 10:30 pagi</td><td>Sesi 1: ${i === 0 ? T.session1_intro : `${T.session1_module} ${i+1} - Bahagian A`}</td></tr>
                            <tr><td>10:30 pagi - 11:00 pagi</td><td>${T.morningBreak}</td></tr>
                            <tr><td>11:00 pagi - 01:00 t/hari</td><td>Sesi 2: ${i === 0 ? `${T.session2_module} 1` : `${T.session2_module} ${i+1} - Bahagian B`}</td></tr>
                            <tr><td>01:00 t/hari - 02:30 petang</td><td>${T.lunchBreak}</td></tr>
                            <tr><td>02:30 petang - 04:00 petang</td><td>Sesi 3: ${T.session3}</td></tr>
                            <tr><td>04:00 petang - 04:30 petang</td><td>${T.afternoonBreak}</td></tr>
                            <tr><td>04:30 petang - 05:30 petang</td><td>Sesi 4: ${T.session4}</td></tr>
                            ${sesiMalamAktif.includes(hariKe) && hariKe < numDays ? `
                            <tr><td>05:30 petang - 08:30 malam</td><td>${T.eveningRest}</td></tr>
                            <tr><td>08:30 malam - 10:30 malam</td><td>${T.eveningSession} (${bahasa === 'melayu' ? `Malam ${hariKe}` : `Night ${hariKe}`})</td></tr>
                            ` : ''}
                        </tbody>
                    </table>
                `;
            }
            return html;
        }

        function generateBajet(numDays, numPeserta, bajetPerPax, lokasi, bahasa) {
            const T = labels[bahasa];
            const toRM = (val) => `RM ${val.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,')}`;
            
            const totalBajetKutipan = bajetPerPax * numPeserta * numDays;
            const feePenceramah = 3500 * numDays;
            const baki = totalBajetKutipan - feePenceramah;
            const kontigensi = baki * 0.10;
            const jumlahKosPakejDanLogistik = baki - kontigensi;

            // Labels
            const pakejLabel = bahasa === 'english' ? 'Participant Package & Logistics' : 'Pakej Latihan Peserta & Kos Logistik';
            const pakejCalc = bahasa === 'english' ? 'Remaining balance after speaker fee & contingency' : 'Baki selepas yuran penceramah & kontigensi';
            const totalLabel = bahasa === 'english' ? 'TOTAL BUDGET (COLLECTION)' : 'JUMLAH BAJET KUTIPAN';
            const speakerCalc = bahasa === 'english' ? `RM 3,500/day × ${numDays} days` : `RM 3,500/hari × ${numDays} hari`;
            const contingencyCalc = bahasa === 'english' ? '10% of balance' : '10% daripada baki';

            return `
                <p style="margin-bottom: 10px;">${T.costIntro}</p>
                <table>
                    <thead>
                        <tr>
                            <th style="width: 5%;">Bil.</th>
                            <th style="width: 40%;">${T.item}</th>
                            <th style="width: 35%;">${T.calculation}</th>
                            <th style="width: 20%;">${T.totalRM}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="text-align: center;">1</td>
                            <td>${T.speakerFee}</td>
                            <td>${speakerCalc}</td>
                            <td style="text-align: right;">${toRM(feePenceramah)}</td>
                        </tr>
                        <tr>
                            <td style="text-align: center;">2</td>
                            <td>${pakejLabel}</td>
                            <td>${pakejCalc}</td>
                            <td style="text-align: right;">${toRM(jumlahKosPakejDanLogistik)}</td>
                        </tr>
                        <tr>
                            <td style="text-align: center;">3</td>
                            <td>${T.contingency}</td>
                            <td>${contingencyCalc}</td>
                            <td style="text-align: right;">${toRM(kontigensi)}</td>
                        </tr>
                         <tr>
                            <td colspan="3" style="text-align: right; font-weight: 800; background-color: #f0f0f0;">${totalLabel}</td>
                            <td style="text-align: right; font-weight: 800; background-color: #f0f0f0;">${toRM(totalBajetKutipan)}</td>
                        </tr>
                    </tbody>
                </table>
                 <p style="font-size: 9pt; margin-top: 0.5rem; font-style: italic; color: #555;">${T.costNote}</p>
            `;
        }

        function displayKertasKerja(aiContent, data, bahasa) {
            const T = labels[bahasa];
            const { namaProgram, namaSyarikat, tentatifHTML, bajetHTML } = data;
            
            kertasKerjaContent.innerHTML = `
                <div style="text-align: center; margin-bottom: 2.5rem;">
                    <h1>${T.proposalTitle}</h1>
                    <h2 style="border: none; margin-top: 0.5rem; margin-bottom: 0;">${T.programHandling} "${namaProgram}"</h2>
                    <h3 style="font-weight: 500; margin-top: 0.25rem;">${T.proposalFor} ${namaSyarikat}</h3>
                </div>

                <h2>${T.introTitle}</h2>
                <p>${aiContent.pengenalan.replace(/\n/g, '<br>')}</p>

                <h2>${T.objectivesTitle}</h2>
                <p>${T.objectivesIntro}</p>
                <ol>${aiContent.objektif.map(o => `<li>${o}</li>`).join('')}</ol>

                <h2>${T.methodsTitle}</h2>
                <p>${T.methodsIntro}</p>
                <ol>${aiContent.kaedah.map(k => `<li>${k}</li>`).join('')}</ol>

                <h2>${T.outcomesTitle}</h2>
                <p>${T.outcomesIntro}</p>
                <ol>${aiContent.hasil.map(h => `<li>${h}</li>`).join('')}</ol>

                <h2>${T.modulesTitle}</h2>
                ${aiContent.modul.map((mod, index) => `
                    <div style="margin-bottom: 1rem;">
                        <h3 style="text-transform: uppercase;">${T.module} ${index + 1}: ${mod.namaModul}</h3>
                        <ol>${mod.pecahanTajuk.map(t => `<li>${t}</li>`).join('')}</ol>
                    </div>
                `).join('')}

                <h2>${T.tentativeTitle}</h2>
                ${tentatifHTML}

                <h2>${T.costTitle}</h2>
                ${bajetHTML}

                <h2>${T.conclusionTitle}</h2>
                <p>${aiContent.penutup.replace(/\n/g, '<br>')}</p>
                
                <div style="margin-top: 4rem; font-size: 11pt;">
                    <p>${T.preparedBy}</p>
                    <br><br><br>
                    <p>....................................................<br>
                    <strong>(${T.consultantTitle})</strong><br>
                    <strong>Impak Niaga</strong>
                    </p>
                </div>
            `;
        }

        // Export PDF
        exportPdfBtn.addEventListener('click', () => {
            const { jsPDF } = window.jspdf;
            const content = document.getElementById('kertasKerjaContent');
            
            // UI Feedback
            const originalBtnContent = exportPdfBtn.innerHTML;
            exportPdfBtn.innerHTML = `<span class="animate-pulse">Sedang Menjana...</span>`;
            exportPdfBtn.disabled = true;

            // Generate
            html2canvas(content, {
                scale: 2, // High quality
                useCORS: true,
                logging: false
            }).then(canvas => {
                const imgData = canvas.toDataURL('image/png');
                const pdf = new jsPDF('p', 'mm', 'a4');
                
                const margin = 15; // 1.5 cm margin
                const pdfWidth = pdf.internal.pageSize.getWidth();
                const pdfHeight = pdf.internal.pageSize.getHeight();
                
                const contentWidth = pdfWidth - (margin * 2);
                const contentHeightPerPage = pdfHeight - (margin * 2);

                const canvasWidth = canvas.width;
                const canvasHeight = canvas.height;
                const ratio = canvasWidth / canvasHeight;

                const totalImgWidth = contentWidth;
                const totalImgHeight = totalImgWidth / ratio;
                
                let heightLeft = totalImgHeight;
                let position = 0;

                pdf.addImage(imgData, 'PNG', margin, margin, totalImgWidth, totalImgHeight);
                heightLeft -= contentHeightPerPage;
                
                let pageNumber = 1;
                const addFooter = () => {
                    pdf.setFontSize(8);
                    pdf.setTextColor(150);
                    const footerText = `${labels[selectedLanguage].page} ${pageNumber} | Impak Niaga`;
                    const textWidth = pdf.getStringUnitWidth(footerText) * pdf.getFontSize() / pdf.internal.scaleFactor;
                    pdf.text(footerText, pdfWidth - margin - textWidth, pdfHeight - 10);
                };

                addFooter();

                while (heightLeft > 0) {
                    position -= contentHeightPerPage;
                    pdf.addPage();
                    pageNumber++;
                    pdf.addImage(imgData, 'PNG', margin, margin + position, totalImgWidth, totalImgHeight);
                    addFooter();
                    heightLeft -= contentHeightPerPage;
                }

                const filename = document.getElementById('namaProgram').value.replace(/[^a-zA-Z0-9]/g, '_') || 'Kertas_Kerja';
                pdf.save(`${filename}.pdf`);

                // Restore Button
                exportPdfBtn.innerHTML = originalBtnContent;
                exportPdfBtn.disabled = false;
            }).catch(err => {
                 console.error("Ralat PDF: ", err);
                 alert("Gagal menjana PDF.");
                 exportPdfBtn.innerHTML = originalBtnContent;
                 exportPdfBtn.disabled = false;
            });
        });
        
        // Date & Checkbox Handlers
        const updateTarikhAkhir = () => {
            const days = parseInt(bilanganHariInput.value) || 1;
            const startDateValue = tarikhMulaInput.value;
            if (startDateValue) {
                const startDate = new Date(startDateValue);
                const timezoneOffset = startDate.getTimezoneOffset() * 60000;
                const correctedStartDate = new Date(startDate.getTime() + timezoneOffset);
                
                const endDate = new Date(correctedStartDate.getTime());
                endDate.setDate(correctedStartDate.getDate() + days - 1);
                
                document.getElementById('tarikhAkhir').valueAsDate = endDate;
            }
        };

        const updateSesiMalamOptions = () => {
            const bilanganHari = parseInt(bilanganHariInput.value) || 0;
            const bahasa = bahasaSelect.value;
            const container = document.getElementById('sesiMalamContainer');
            const wrapper = document.getElementById('sesiTambahanWrapper');
            
            container.innerHTML = ''; 

            if (bilanganHari < 2) {
                wrapper.classList.add('hidden'); 
                return;
            }
            
            wrapper.classList.remove('hidden'); 
            
            for (let i = 1; i < bilanganHari; i++) {
                const labelTeks = bahasa === 'melayu' ? `Malam ${i}` : `Night ${i}`;
                const labelTeksUtama = bahasa === 'melayu' ? 'Sesi Malam' : 'Evening Session';

                const checkboxHTML = `
                <div class="flex items-center p-2 bg-white rounded border border-blue-100 hover:border-gold transition-colors">
                   <input id="sesiMalam_${i}" type="checkbox" value="${i}" class="w-4 h-4 text-navy bg-gray-100 border-gray-300 rounded focus:ring-gold focus:ring-2 sesi-malam-checkbox cursor-pointer">
                   <label for="sesiMalam_${i}" class="ml-3 text-sm font-medium text-navy cursor-pointer select-none">${labelTeksUtama} - ${labelTeks}</label>
               </div>`;
                container.innerHTML += checkboxHTML;
            }
        };

        // Initialization
        document.addEventListener('DOMContentLoaded', () => {
            const today = new Date();
            today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
            tarikhMulaInput.valueAsDate = today;

            bilanganHariInput.addEventListener('change', () => {
                updateTarikhAkhir();
                updateSesiMalamOptions(); 
            });
            tarikhMulaInput.addEventListener('change', updateTarikhAkhir);
            bahasaSelect.addEventListener('change', updateSesiMalamOptions); 
            
            updateTarikhAkhir();
            updateSesiMalamOptions();
        });
    </script>
</body>
