rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isValidProposalStatus(status) {
      return status in ['Draf', 'Dihantar', 'Diluluskan', 'Ditolak'];
    }

    function isValidProposal(data) {
      return data.keys().hasAll([
          'ownerId',
          'status',
          'title',
          'companyName',
          'bahasa',
          'totalBudget',
          'days',
          'participants',
          'startDate',
          'formData',
          'aiContent',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'status',
          'title',
          'companyName',
          'bahasa',
          'totalBudget',
          'days',
          'participants',
          'startDate',
          'formData',
          'aiContent',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid
        && data.status is string && isValidProposalStatus(data.status)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 240
        && data.bahasa is string && data.bahasa in ['melayu', 'english']
        && data.totalBudget is number && data.totalBudget >= 0 && data.totalBudget <= 100000000
        && data.days is number && data.days >= 1 && data.days <= 30
        && data.participants is number && data.participants >= 1 && data.participants <= 10000
        && data.startDate is string && data.startDate.size() >= 1 && data.startDate.size() <= 20
        && data.formData is map && data.formData.keys().size() <= 30
        && data.aiContent is map && data.aiContent.keys().size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserSettings(data, userId) {
      return data.keys().hasAll(['ownerId', 'branding', 'trainerProfile', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'branding', 'trainerProfile', 'updatedAt'])
        && data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid && data.ownerId == userId
        && data.branding is map && data.branding.keys().size() <= 20
        && data.trainerProfile is map && data.trainerProfile.keys().size() <= 15
        && data.updatedAt is timestamp;
    }

    match /proposals/{proposalId} {
      allow get: if isSignedIn() && isValidId(proposalId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(proposalId)
        && isValidProposal(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(proposalId)
        && isOwner(existing().ownerId)
        && isValidProposal(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'status',
            'title',
            'companyName',
            'bahasa',
            'totalBudget',
            'days',
            'participants',
            'startDate',
            'formData',
            'aiContent',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser() && isValidId(proposalId) && isOwner(existing().ownerId);
    }

    match /userSettings/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserSettings(incoming(), userId)
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserSettings(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['branding', 'trainerProfile', 'updatedAt']);

      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);
    }
  }
}
